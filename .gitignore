# ===== 隐私红线：真实用户数据（最高优先级，务必保持在最前）=====
.zcode/
**/HyperSS/projects/**
**/.drafts/**
*.db
*.sqlite
*.sqlite3

# ===== 签名与密钥 =====
*.jks
*.keystore
keystore.properties
*.pem
*.p12

# ===== 本地环境配置 =====
local.properties
*.env
.env.local

# ===== Android / Gradle 构建产物 =====
android-app/**/build/
android-app/.gradle/
*.apk
*.aab
*.ap_
*.dex

# ===== Rust 构建产物 =====
rust-core/target/
Cargo.lock

# ===== UniFFI 生成的绑定代码（流水线中动态生成，无需入库）=====
android-app/core-bindings/generated/

# ===== cargo-ndk 交叉编译产物（构建时自动生成，无需入库）=====
android-app/app/src/main/jniLibs/**/*.so

